{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ad-astra-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "84721631",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8788,http://127.0.0.1:8788"
  }
}
